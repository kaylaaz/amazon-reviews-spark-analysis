    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "+-----------+-------------+----------------------+---------------------+------------+-----+\n",
      "|star_rating|review_length|review_headline_length|verified_purchase_idx|category_idx|label|\n",
      "+-----------+-------------+----------------------+---------------------+------------+-----+\n",
      "|          1|            1|                     1|                  0.0|        24.0|  0.0|\n",
      "|          1|            1|                     8|                  0.0|         0.0|  1.0|\n",
      "|          1|            2|                     2|                  0.0|         3.0|  0.0|\n",
      "|          1|            2|                     2|                  0.0|         5.0|  0.0|\n",
      "|          1|            2|                     8|                  0.0|         3.0|  0.0|\n",
      "+-----------+-------------+----------------------+---------------------+------------+-----+\n",
      "only showing top 5 rows\n",
      "\n"
     ]
    }
   ],
   "source": [
    "train_df.show(5)"
   ]
  },
