    "## 5 Speedup Analysis\n",
    "\n",
    "We measure the speedup of distributed training by running GBT training with **1 executor** vs. the **full allocation (15 executors)** on SDSC Expanse."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4ca98482",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Speedup: 1.10x, Efficiency: 7.4%\n"
     ]
    }
   ],
   "source": [
    "import time\n",
    "from pyspark.ml.classification import GBTClassifier\n",
    "\n",
    "# Baseline: 1 executor\n",
    "start = time.time()\n",
    "#======= GBT Model Starts =========\n",
    "assembler = VectorAssembler(inputCols=feature_cols, outputCol=\"features\", handleInvalid=\"skip\")\n",
    "gbt_a = GBTClassifier(featuresCol=\"features\", labelCol=\"label\", maxIter=20, maxDepth=3, maxBins=64, stepSize=0.1, seed=42)\n",
    "pipeline_gbt_a = Pipeline(stages=[assembler, gbt_a])\n",
    "model_gbt_a = pipeline_gbt_a.fit(train_df)\n",
    "#======= GBT Model Ends =========\n",
    "\n",
    "T_1 = time.time() - start\n",
    "\n",
