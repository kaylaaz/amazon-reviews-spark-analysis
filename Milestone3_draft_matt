   "source": [
    "Label 1 is 3 times larger than the other. When measuring accuracy, AUC and F1 scoring have to be used to evaluate considering the imbalance of data."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8b5ad09f",
   "metadata": {},
   "source": [
    "## 2. Train Your First Distributed Model (8 points)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c90b20d0",
   "metadata": {},
   "source": [
    "### Feature Assembly & Train/Val/Test Split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "b284fac8",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pyspark.ml.classification import RandomForestClassifier\n",
    "from pyspark.ml.evaluation import BinaryClassificationEvaluator, MulticlassClassificationEvaluator\n",
    "from pyspark.ml import Pipeline\n",
    "\n",
    "feature_cols = [\n",
    "    \"star_rating\",\n",
    "    \"review_length\",\n",
    "    \"review_headline_length\",\n",
    "    # \"review_year\", (#seems irrelavent when predicting the future review)\n",
    "    # \"vine_idx\", (#vine seems irrelavent to the helpfulness as stated above)\n",
    "    \"verified_purchase_idx\",\n",
    "    \"category_idx\"\n",
    "]\n",
    "\n",
    "assembler = VectorAssembler(inputCols=feature_cols, outputCol=\"features\", handleInvalid=\"skip\")\n",
    "\n",
    "cols_needed = feature_cols + [\"label\"]\n",
    "\n",
    "train_df, val_df, test_df = df_clean.select(cols_needed).randomSplit([0.7, 0.15, 0.15], seed=42)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "ae28c245-a541-4330-8760-e62ca146f38b",
   "metadata": {},
